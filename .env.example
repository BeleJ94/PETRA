# Petra — développé par BELEJ-CONSULTING. Copier en .env et adapter.
APP_ENV=local
APP_DEBUG=true
# Sous-répertoire d'URL si l'app n'est pas servie à la racine du vhost (ex. /Petra sous XAMPP)
APP_BASE_PATH=
SESSION_SECURE=false

# Fuseau horaire de la station (dates affichées et enregistrées, session MariaDB)
APP_TIMEZONE=Africa/Lubumbashi
# Devise de référence des écarts : CDF. L'USD remis est converti au taux de la tranche.
APP_CURRENCY=CDF

# station : serveur local d'une station (fonctionne sans Internet)
# central : VPS recevant toutes les stations (vue consolidée du propriétaire)
APP_MODE=station
# UUID de cette station (mode station uniquement)
STATION_ID=
# API HTTPS du serveur central et jeton propre à cette station (bin/sync.php, cron)
SYNC_URL=
SYNC_TOKEN=

# Sauvegardes (bin/backup.php) : dossier (storage/backups par défaut), jours de conservation,
# dossier contenant mysqldump et mysql (C:\xampp\mysql\bin est trouvé tout seul)
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
MYSQL_BIN_DIR=

# Base de données : petra en exploitation ; petra_test est imposée par phpunit.xml pour les tests
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petra
DB_USER=petra
DB_PASS=
